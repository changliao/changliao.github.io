@article{liao2026unstructured,
  abbr         = {JAMES},
  bibtex_show  = {true},
  title        = {An Unstructured {Voronoi} Mesh Framework for Large-Scale Hydrologic and Land Surface Models},
  author       = {Liao, Chang and Engwirda, Darren and Xu, Donghui and Zhou, Tian and Tan, Zeli and Leung, L. Ruby},
  journal      = {Journal of Advances in Modeling Earth Systems},
  year         = {2026},
  note         = {Accepted},
  selected     = {true},
  abstract     = {Accurate representation of river networks and land surface heterogeneity is crucial for improving the performance of continental-to-global hydrologic and land surface models (LSMs). Traditional approaches rely on either coarse-resolution grids, which may oversimplify complex terrain and limit the accurate representation of key processes, or computationally demanding full-domain high-resolution meshes. This study introduces a novel framework for generating Hydrologic Refined Meshes (HRMs) that seamlessly integrates crucial land surface features, including river networks, watershed boundaries, and lake boundaries, into the mesh generation process within the Model for Prediction Across Scales (MPAS) architecture.}
}

@article{li2026systematic,
